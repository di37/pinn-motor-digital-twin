# macOS metadata
**/*.DS_Store

# Python bytecode
**/__pycache__/

# Jupyter autosaves
**/.ipynb_checkpoints/

# Raw dataset (300 MB, fetched by sl-report/scripts/00a, verified against the committed fingerprint)
